# Base URL of the FastAPI backend.
VITE_API_BASE_URL=http://localhost:8000

VITE_APP_NAME=PPALMA Persistent Crime Pattern Analysis Tool

# "synthetic" while the demonstration dataset is in use; "official" once real
# PNP records have replaced it.
VITE_DATA_SOURCE=synthetic

# Shows the demonstration-mode banner. Only an explicit "false" turns it off,
# so a missing or malformed value fails safe by keeping the warning visible.
VITE_DEMO_MODE=true
