        <mxCell id="a6" style="html=1;endArrow=none;startArrow=none;rounded=0;exitX=1;exitY=0.44;entryX=0;entryY=0.5;" edge="1" parent="1" source="uc_analyst" target="oc_munistat"><mxGeometry relative="1" as="geometry" /></mxCell>
