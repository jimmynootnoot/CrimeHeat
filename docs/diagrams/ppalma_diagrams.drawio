  <diagram name="2.5.3 Architecture Diagram" id="arch1">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="ar_pres" value="Presentation Layer &#8212; Browser Client&#10;(React + Vite + TypeScript + Tailwind CSS)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;fontSize=13;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="180" y="60" width="620" height="220" as="geometry" />
        </mxCell>
        <mxCell id="ar_pages" value="Pages&#10;Login, Dashboard, Map,&#10;Upload, Records, Reports" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="210" y="110" width="190" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ar_mapc" value="Map Components (React-Leaflet)&#10;Boundary / Incident / Cluster /&#10;Persistence / Heatmap layers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="430" y="110" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ar_axios" value="Axios API Client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="320" y="240" width="220" height="30" as="geometry" />
        </mxCell>

        <mxCell id="ar_osm" value="OpenStreetMap&#10;Tile Server&#10;(external service)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="900" y="100" width="200" height="100" as="geometry" />
        </mxCell>

        <mxCell id="ar_app" value="Application Layer &#8212; FastAPI Backend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;fontStyle=1;fontSize=13;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="180" y="380" width="620" height="220" as="geometry" />
        </mxCell>
        <mxCell id="ar_routes" value="Routes&#10;auth, municipalities, incidents,&#10;upload, clusters, persistence,&#10;reports, dashboard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="210" y="430" width="190" height="140" as="geometry" />
        </mxCell>
        <mxCell id="ar_core" value="Core (cross-cutting)&#10;JWT + bcrypt auth,&#10;RBAC require_role" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="430" y="430" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ar_services" value="Services&#10;import_service, clustering (DBSCAN),&#10;persistence_service, audit_service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="430" y="510" width="330" height="60" as="geometry" />
        </mxCell>

        <mxCell id="ar_data" value="Data Layer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;fontStyle=1;fontSize=13;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="180" y="700" width="620" height="140" as="geometry" />
        </mxCell>
        <mxCell id="ar_db" value="PostgreSQL + PostGIS&#10;via SQLAlchemy + GeoAlchemy2 ORM&#10;(Users/Roles, Municipalities/Barangays,&#10;Incidents, ImportBatch/Dataset,&#10;Clusters, Persistence, ReferenceHotspot)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="290" y="740" width="400" height="80" as="geometry" />
        </mxCell>

        <mxCell id="ar_e1" style="html=1;endArrow=none;startArrow=none;rounded=0;" edge="1" parent="1" source="ar_pages" target="ar_axios"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ar_e2" style="html=1;endArrow=none;startArrow=none;rounded=0;" edge="1" parent="1" source="ar_mapc" target="ar_axios"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="ar_e3" value="REST / JSON over HTTPS" style="html=1;endArrow=classic;startArrow=classic;rounded=0;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ar_pres" target="ar_app"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ar_e4" value="SQL" style="html=1;endArrow=classic;startArrow=classic;rounded=0;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ar_app" target="ar_data"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ar_e5" value="tile requests / tile images" style="html=1;endArrow=classic;startArrow=classic;rounded=0;fontSize=10;" edge="1" parent="1" source="ar_mapc" target="ar_osm"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ar_e6" style="html=1;endArrow=none;startArrow=none;rounded=0;" edge="1" parent="1" source="ar_routes" target="ar_core"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ar_e7" style="html=1;endArrow=open;endFill=0;rounded=0;" edge="1" parent="1" source="ar_routes" target="ar_services"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
