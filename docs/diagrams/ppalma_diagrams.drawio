<mxfile host="app.diagrams.net">
  <diagram name="2.5.1 Context Diagram" id="context1">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="ctx_analyst" value="Analyst" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="140" width="50" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ctx_admin" value="Admin" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="540" width="50" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ctx_sys" value="PPALMA Crime&#10;Mapping Tool" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="500" y="330" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="ctx_pnp" value="PNP / LGU Crime&#10;Records Source&#10;(synthetic in dev)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="960" y="140" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ctx_osm" value="OpenStreetMap&#10;Tile Server" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="960" y="540" width="220" height="100" as="geometry" />
        </mxCell>

        <mxCell id="ctx_e1" value="login, queries //&#10;dashboards, maps, records, reports" style="html=1;endArrow=classic;startArrow=classic;rounded=0;fontSize=10;" edge="1" parent="1" source="ctx_analyst" target="ctx_sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ctx_e2" value="login, uploads, commit/delete //&#10;results, confirmations" style="html=1;endArrow=classic;startArrow=classic;rounded=0;fontSize=10;" edge="1" parent="1" source="ctx_admin" target="ctx_sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ctx_e3" value="raw incident data (import)" style="html=1;endArrow=classic;startArrow=none;rounded=0;fontSize=10;" edge="1" parent="1" source="ctx_pnp" target="ctx_sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ctx_e4" value="tile requests //&#10;tile images" style="html=1;endArrow=classic;startArrow=classic;rounded=0;fontSize=10;" edge="1" parent="1" source="ctx_sys" target="ctx_osm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="2.5.2 Use Case Diagram" id="usecase1">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1050" math="0" shadow="0">
