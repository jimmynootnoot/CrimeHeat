# Local PostgreSQL/PostGIS (default). Swap for a Supabase Postgres URL when demoing —
# no code changes required, only this value.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ppalma_crime

# --- Authentication ---
# Never commit a real secret. Generate one, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-this-to-a-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Data source ---
# Provenance label for imported datasets:
# official | geocoded | generalized | manually_verified
DATA_SOURCE=official

# --- DBSCAN ---
# Neighbourhood radius in kilometres and minimum-samples density. Shown to
# users in the analysis screens with tooltips — not hidden internals.
# eps is a true great-circle distance: clustering uses the haversine metric
# over radian-converted coordinates, never raw degrees.
DBSCAN_EPS_KM=1.0
DBSCAN_MIN_SAMPLES=4
DEFAULT_PERIOD_TYPE=yearly

# --- Cross-period cluster matching ---
# A chain's persistence_score = periods_present / total_periods_analyzed.
# At or above PERSISTENCE_SCORE_THRESHOLD it is persistent: "active" when
# present in the latest analyzed period, "historical" when not. Below the
# threshold it is "intermittent" (2+ periods) or "temporary" (exactly 1).
# Set MIN_SPATIAL_OVERLAP_PERCENT to 0 to match on centroid distance alone.
PERSISTENCE_MATCH_DISTANCE_KM=1.5
MIN_SPATIAL_OVERLAP_PERCENT=0
PERSISTENCE_MIN_PERIODS=2
PERSISTENCE_SCORE_THRESHOLD=0.5
ACTIVE_LATEST_PERIOD_REQUIRED=true

# --- Evaluation weights ---
# A weighting scheme for combining two different kinds of measurement.
# These are NOT a margin of error.
WEIGHT_ALGORITHMIC=0.90
WEIGHT_FUNCTIONAL=0.10

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=100.0

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173
