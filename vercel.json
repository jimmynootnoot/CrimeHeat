{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix frontend ci && npm --prefix frontend run build",
  "functions": {
    "api/index.py": {
      "includeFiles": "{backend/**,data/**,frontend/dist/**}",
      "excludeFiles": "{backend/.env,frontend/.env,backend/tests/**,backend/migrations/**,data/evaluation_demo/**,**/__pycache__/**,**/*.pyc}",
      "maxDuration": 300
    }
  }
}
